<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer black border -->
    <item>
        <shape>
            <solid android:color="@android:color/white" /> <!-- Background color -->
            <stroke android:color="@color/black" android:width="1dp" />
        </shape>
    </item>

    <!-- Inner colored border -->
    <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="1dp">
        <shape>
            <solid android:color="@android:color/white" /> <!-- Optional inner content color -->
            <stroke android:color="#8094DB" android:width="4dp" />
        </shape>
    </item>

</layer-list>