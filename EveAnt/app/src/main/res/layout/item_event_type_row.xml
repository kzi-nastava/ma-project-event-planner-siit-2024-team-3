<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <data />

    <!-- “Card” without Material: just a rounded bg with margins/padding -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/bg_card_white_20">

        <!-- Header row: title + edit + switch -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#1b1b1b"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"/>

            <ImageButton
                android:id="@+id/btnEdit"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/edit"
                android:src="@drawable/ic_edit_blue"/>

            <!-- Your custom-styled SwitchCompat (works fine without Material) -->
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swActive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:splitTrack="false"
                android:thumb="@drawable/switch_thumb_custom"
                app:track="@drawable/switch_track_custom"
                app:switchMinWidth="50dp"
                app:switchPadding="8dp"/>
        </LinearLayout>

        <!-- Description -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#424242"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:ellipsize="end"/>

        <!-- Suggested categories (chips added programmatically) -->
        <LinearLayout
            android:id="@+id/llSuggestedContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"/>
    </LinearLayout>
</layout>
