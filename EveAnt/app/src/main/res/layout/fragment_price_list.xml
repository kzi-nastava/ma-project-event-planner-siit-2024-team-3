<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F0F3FF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="0dp">
            <RelativeLayout
                android:id="@+id/home_search_rectangle_layout"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:background="@drawable/service_search_rectangle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/place"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="20dp"
                    android:fontFamily="@font/poppins_bold"
                    android:text="Price list"
                    android:textSize="30sp"
                    android:textAppearance="@style/place"
                    android:textStyle="bold" />


            </RelativeLayout>

            <Button
                android:id="@+id/export_pdf_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Donload PDF"
                android:layout_margin="16dp"
                android:layout_gravity="center" />

            <androidx.recyclerview.widget.RecyclerView android:id="@+id/priceListItem"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp"
                android:clipToPadding="false"
                tools:listitem="@layout/price_list_item"
                xmlns:tools="http://schemas.android.com/tools" />


        </LinearLayout>
    </ScrollView>


</FrameLayout>

