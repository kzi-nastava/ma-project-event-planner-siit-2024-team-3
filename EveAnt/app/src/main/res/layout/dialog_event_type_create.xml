<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data />

    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_card_white_20"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:text="Create Event Type"
            android:textStyle="bold"
            android:textColor="#000000"
            android:textSize="20sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/etName"
            android:hint="Name"
            android:layout_marginTop="12dp"
            android:padding="14dp"
            android:textColor="#8599e0"
            android:background="@drawable/bg_input_soft"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <EditText
            android:id="@+id/etDescription"
            android:hint="Description"
            android:layout_marginTop="10dp"
            android:minLines="3"
            android:padding="14dp"
            android:gravity="top"
            android:background="@drawable/bg_input_soft"
            android:textColor="#8599e0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:text="Choose categories affiliated to this event type:"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginTop="14dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_marginTop="8dp"
            android:padding="8dp"
            android:background="@drawable/bg_soft_panel"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAllCategories"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCreate"
            android:text="Create"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_primary_pill"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="48dp"/>
    </LinearLayout>
</layout>
