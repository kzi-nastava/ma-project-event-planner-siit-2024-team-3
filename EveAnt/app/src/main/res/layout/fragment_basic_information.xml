<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp"
    tools:context=".event.BasicEventInfoFragment">

    <!-- Card/backdrop to match Step 1 -->
    <LinearLayout
        android:id="@+id/cardRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_marginBottom="50dp"
        android:padding="16dp"
        android:background="@drawable/rounded_corners_white">

        <!-- Steps row (same as Step 1) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/llSteps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <TextView
                    android:id="@+id/step1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Select type"
                    android:textStyle="normal"
                    android:textColor="#000000"
                    android:paddingRight="12dp" />

                <TextView
                    android:id="@+id/step2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. Basic info"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:paddingRight="12dp" />

                <TextView
                    android:id="@+id/step3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3. Budget and buy"
                    android:textColor="#000000"
                    android:paddingRight="12dp" />

                <TextView
                    android:id="@+id/step4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4. Agenda"
                    android:textColor="#000000"
                    android:paddingRight="12dp" />

                <TextView
                    android:id="@+id/step5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5. Invitations"
                    android:textColor="#000000" />
            </LinearLayout>
        </HorizontalScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="8dp" />

        <!-- Content area -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Title/subtitle (kept to match Step 1) -->
                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Basic event information"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:paddingBottom="6dp" />

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fill out core details and privacy"
                    android:textSize="14sp"
                    android:textColor="#000000"
                    android:paddingBottom="12dp" />

                <!-- GRID: two cards, stacked for mobile but visually like web -->
                <!-- Event information card -->
                <LinearLayout
                    android:id="@+id/cardEventInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:background="@drawable/rounded_corners_white"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Event information"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:paddingBottom="8dp"/>

                    <EditText
                        android:id="@+id/etName"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/rounded_corners_f0f3ff"
                        android:hint="Name"
                        android:padding="12dp"
                        android:maxLines="1"
                        android:inputType="textCapSentences|textPersonName"
                        android:textColor="#000000"
                        android:textColorHint="#88000000"/>

                    <EditText
                        android:id="@+id/etDescription"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/rounded_corners_f0f3ff"
                        android:hint="Description"
                        android:padding="12dp"
                        android:gravity="top|start"
                        android:inputType="textMultiLine"
                        android:textColor="#000000"
                        android:textColorHint="#88000000" />

                    <!-- Optional numeric field like in your web mock (the '0') -->
                    <EditText
                        android:id="@+id/etCapacity"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/rounded_corners_f0f3ff"
                        android:hint="Max attendees"
                        android:padding="12dp"
                        android:inputType="number"
                        android:textColor="#000000"
                        android:textColorHint="#88000000"
                        android:text="0"/>
                </LinearLayout>

                <!-- Event details card -->
                <LinearLayout
                    android:id="@+id/cardEventDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:background="@drawable/rounded_corners_white"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Event details"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:paddingBottom="8dp"/>

                    <EditText
                        android:id="@+id/etCountry"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/rounded_corners_f0f3ff"
                        android:hint="Enter country"
                        android:padding="12dp"
                        android:inputType="textCapWords"
                        android:textColor="#000000"
                        android:textColorHint="#88000000"/>

                    <EditText
                        android:id="@+id/etCity"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/rounded_corners_f0f3ff"
                        android:hint="Enter city"
                        android:padding="12dp"
                        android:inputType="textCapWords"
                        android:textColor="#000000"
                        android:textColorHint="#88000000"/>

                    <EditText
                        android:id="@+id/etStreet"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/rounded_corners_f0f3ff"
                        android:hint="Enter street"
                        android:padding="12dp"
                        android:inputType="textCapWords"
                        android:textColor="#000000"
                        android:textColorHint="#88000000"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/etHouseNo"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:background="@drawable/rounded_corners_f0f3ff"
                            android:hint="Enter house/ number"
                            android:padding="12dp"
                            android:inputType="text|number"
                            android:textColor="#000000"
                            android:textColorHint="#88000000"/>

                        <View
                            android:layout_width="10dp"
                            android:layout_height="1dp"/>

                        <EditText
                            android:id="@+id/etZip"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:background="@drawable/rounded_corners_f0f3ff"
                            android:hint="ZIP"
                            android:padding="12dp"
                            android:inputType="number"
                            android:textColor="#000000"
                            android:textColorHint="#88000000"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvDate"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:paddingLeft="12dp"
                            android:background="@drawable/rounded_corners_f0f3ff"
                            android:text="mm/dd/yyyy"
                            android:textColor="#88000000"/>

                        <View
                            android:layout_width="10dp"
                            android:layout_height="1dp"/>

                        <TextView
                            android:id="@+id/tvTime"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:paddingLeft="12dp"
                            android:background="@drawable/rounded_corners_f0f3ff"
                            android:text="--:--"
                            android:textColor="#88000000"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Privacy settings card -->
                <LinearLayout
                    android:id="@+id/cardPrivacy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:background="@drawable/rounded_corners_white"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Privacy settings"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:paddingBottom="8dp"/>

                    <RadioGroup
                        android:id="@+id/rgPrivacy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rbPrivate"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:text="Private"
                            android:checked="true"
                            android:textColor="#000000" />

                        <RadioButton
                            android:id="@+id/rbPublic"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:text="Public"
                            android:textColor="#000000" />
                    </RadioGroup>
                </LinearLayout>

                <!-- Add photos card -->
                <LinearLayout
                    android:id="@+id/cardPhotos"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="14dp"
                    android:background="@drawable/rounded_corners_image_blue">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_add_foreground"
                        android:contentDescription="@string/app_name"/>

                    <TextView
                        android:id="@+id/tvAddPhotos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="6dp"
                        android:text="Add photos"
                        android:textColor="#000000" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#B00020"
                    android:visibility="gone"
                    android:paddingTop="8dp"
                    tools:text="Please fill in required fields."/>

            </LinearLayout>
        </ScrollView>

        <!-- Buttons row (same as Step 1) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="8dp">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="BACK"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:textColor="#000000" />

            <View
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/btnNext"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="NEXT"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:textColor="#000000" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
