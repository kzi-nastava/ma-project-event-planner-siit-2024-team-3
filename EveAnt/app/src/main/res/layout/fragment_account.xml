<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <data>
        <variable
            name="user"
            type="com.example.eveant.user.model.User" />
        <variable
            name="profile"
            type="com.example.eveant.user.model.Profile"/>
    </data>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#f0f3ff"
        android:paddingBottom="60dp"
        tools:context=".user.AccountFragment">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <include
                layout="@layout/fragment_back"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/profile_photo"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_gravity="center"
                    android:src="@drawable/rounded_corners_image" />

                <Button
                    android:id="@+id/change_photo_button"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/rounded_corners_8599e0"
                    android:fontFamily="@font/poppins_medium"
                    android:padding="10dp"
                    android:text="Change profile photo"
                    android:textColor="@color/white" />

                <Button
                    android:id="@+id/delete_photo_button"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/rounded_corners_f26a8d"
                    android:fontFamily="@font/poppins_medium"
                    android:padding="10dp"
                    android:text="Delete profile photo"
                    android:textColor="@color/white" />
            </LinearLayout>

            <!-- Personal Information Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/rounded_corners_white"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/personal_info_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="Personal Information"
                    android:textColor="@color/black"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rounded_corners_f0f3ff"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/name"
                        style="@style/loginInputText"
                        android:imeActionLabel="@string/action_sign_in_short"
                        android:imeOptions="actionDone"
                        android:inputType="textPersonName"
                        android:selectAllOnFocus="true"
                        android:text="@{user.firstName}" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/rounded_corners_f0f3ff"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/surname"
                        style="@style/loginInputText"
                        android:imeActionLabel="@string/action_sign_in_short"
                        android:imeOptions="actionDone"
                        android:inputType="text"
                        android:text="@{user.lastName}" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/rounded_corners_f0f3ff"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginStart="16dp"
                        android:background="@drawable/mail" />

                    <EditText
                        android:id="@+id/email"
                        style="@style/loginInputText"
                        android:inputType="textEmailAddress"
                        android:text="@{profile.email}" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/rounded_corners_f0f3ff"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginStart="16dp"
                        android:background="@drawable/person_vector" />

                    <EditText
                        android:id="@+id/username"
                        style="@style/loginInputText"
                        android:inputType="text"
                        android:text="@{profile.username}" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/rounded_corners_f0f3ff"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginStart="16dp"
                        android:background="@drawable/ic_calendar" />

                    <EditText
                        android:id="@+id/birthday"
                        style="@style/loginInputText"
                        android:inputType="date"
                        android:text="@{user.dateOfBirth}" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/rounded_corners_f0f3ff"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginStart="16dp"
                        android:background="@drawable/telephone" />

                    <EditText
                        android:id="@+id/phoneNumber"
                        style="@style/loginInputText"
                        android:inputType="text|phone"
                        android:text="@{user.phoneNumber}" />
                </LinearLayout>

                <Button
                    android:id="@+id/saveChangesButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/rounded_corners_8599e0"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Save Changes"
                    android:textColor="@color/white"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/editPersonalInfoButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/rounded_corners_8599e0"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Edit"
                    android:textColor="@color/white"
                    android:visibility="visible" />
            </LinearLayout>


            <!-- Address Information Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/rounded_corners_white"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/address_info_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="Address Information"
                    android:textColor="@color/black"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/rounded_corners_f0f3ff"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginStart="16dp"
                        android:background="@drawable/location" />

                    <EditText
                        android:id="@+id/country"
                        style="@style/loginInputText"
                        android:inputType="text"
                        android:text="@{user.address.country}" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/rounded_corners_f0f3ff"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginStart="16dp"
                        android:background="@drawable/location" />

                    <EditText
                        android:id="@+id/city"
                        style="@style/loginInputText"
                        android:inputType="text"
                        android:text="@{user.address.city}" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/rounded_corners_f0f3ff"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginStart="16dp"
                        android:background="@drawable/location" />

                    <EditText
                        android:id="@+id/street"
                        style="@style/loginInputText"
                        android:inputType="text"
                        android:text="@{user.address.street}" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/rounded_corners_f0f3ff"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginStart="16dp"
                        android:background="@drawable/location" />

                    <EditText
                        android:id="@+id/postalNumber"
                        style="@style/loginInputText"
                        android:inputType="text"
                        android:text="@{user.address.postalNumber}" />
                </LinearLayout>

                <Button
                    android:id="@+id/saveChangesButtonAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/rounded_corners_8599e0"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Save Changes"
                    android:textColor="@color/white"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/editPersonalInfoButtonAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/rounded_corners_8599e0"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Edit"
                    android:textColor="@color/white"
                    android:visibility="visible" />

            </LinearLayout>

            <!-- Change Password Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="288dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/rounded_corners_white"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/change_password_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Change Password"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/rounded_corners_f0f3ff"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginStart="16dp"
                        android:background="@drawable/lock" />

                    <EditText
                        android:id="@+id/password"
                        style="@style/loginInputText"
                        android:hint="@string/prompt_password"
                        android:imeActionLabel="@string/action_sign_in_short"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/rounded_corners_f0f3ff"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginStart="16dp"
                        android:background="@drawable/lock" />

                    <EditText
                        android:id="@+id/new_password"
                        style="@style/loginInputText"
                        android:hint="@string/prompt_newPassword"
                        android:imeActionLabel="@string/action_sign_in_short"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/rounded_corners_f0f3ff"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginStart="16dp"
                        android:background="@drawable/lock" />

                    <EditText
                        android:id="@+id/confirmPassword"
                        style="@style/loginInputText"
                        android:hint="@string/prompt_confirmPassword"
                        android:inputType="textPassword" />
                </LinearLayout>

                <Button
                    android:id="@+id/saveChangesButtonPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/rounded_corners_8599e0"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Save Changes"
                    android:textColor="@color/white"
                    android:visibility="gone" />
            </LinearLayout>
            <Button
                android:id="@+id/logout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/rounded_corners_8599e0"
                android:fontFamily="@font/poppins_medium"
                android:text="Logout"
                android:textColor="@color/white"
                android:visibility="visible" />
            <Button
                android:id="@+id/btnDeactivateAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/rounded_corners_f26a8d"
                android:text="Deactivate account"
                android:textColor="@color/white" />
        </LinearLayout>

    </ScrollView>
</layout>
