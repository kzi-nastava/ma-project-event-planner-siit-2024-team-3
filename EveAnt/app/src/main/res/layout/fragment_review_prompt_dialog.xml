<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/body"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/ivCover"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:scaleType="centerCrop"
            android:src="@drawable/rounded_corners_image_blue" />

        <TextView
            android:id="@+id/tvTitle"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:paddingTop="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Event title" />

        <TextView
            android:id="@+id/tvWhen"
            android:textColor="#555"
            android:paddingTop="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2025-07-22 19:00" />

        <TextView
            android:paddingTop="14dp"
            android:text="How was it?"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <RatingBar
            android:id="@+id/ratingBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:progressTint="@color/purple"
            android:secondaryProgressTint="#bec9f1"
            android:progressBackgroundTint="#f0f3ff"
            android:stepSize="1.0" />

        <EditText
            android:id="@+id/etComment"
            android:hint="Add a comment (optional)"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:maxLines="4"
            android:gravity="top"
            android:paddingTop="8dp"/>

        <LinearLayout
            android:orientation="horizontal"
            android:gravity="end"
            android:paddingTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/btnLater"
                android:text="Later"
                android:background="@drawable/rounded_corners_f0f3ff"
                android:layout_width="wrap_content"
                android:textColor="@color/purple"
                android:layout_marginBottom="8dp"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnSubmit"
                android:text="Submit"
                android:background="@drawable/rounded_corners_8599e0"
                android:textColor="@color/white"
                android:layout_marginBottom="8dp"
                android:layout_marginLeft="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            android:visibility="gone"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
</ScrollView>
