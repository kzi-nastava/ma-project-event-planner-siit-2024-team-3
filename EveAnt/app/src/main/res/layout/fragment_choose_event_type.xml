<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/fragmentContainer">


    <!-- Card/backdrop -->
    <LinearLayout
        android:id="@+id/cardRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/rounded_corners_white"
        android:orientation="vertical"
        android:layout_marginBottom="50dp" >
        <include
            layout="@layout/fragment_back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- Steps row -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/llSteps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <TextView
                    android:id="@+id/step1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Select type"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:paddingRight="12dp" />

                <TextView
                    android:id="@+id/step2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. Basic info"
                    android:textColor="#000000"
                    android:paddingRight="12dp" />

                <TextView
                    android:id="@+id/step3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3. Budget and buy"
                    android:textColor="#000000"
                    android:paddingRight="12dp" />

                <TextView
                    android:id="@+id/step4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4. Agenda"
                    android:textColor="#000000"
                    android:paddingRight="12dp" />

                <TextView
                    android:id="@+id/step5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5. Invitations"
                    android:textColor="#000000" />
            </LinearLayout>
        </HorizontalScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="8dp" />

        <!-- Content area -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="16dp"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="What kind of event do you want to organize?"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:padding="16dp"
                    android:textColor="#000000"
                    android:paddingBottom="6dp" />

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select an event type"
                    android:textSize="14sp"
                    android:textColor="#000000"
                    android:paddingBottom="12dp" />

                <!-- Loading & error -->
                <ProgressBar
                    android:id="@+id/progress"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#000000"
                    android:text=""
                    android:visibility="gone"
                    android:paddingBottom="8dp" />

                <!-- Dynamic event types -->
                <RadioGroup
                    android:id="@+id/rgEventTypes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <!-- Buttons row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="16dp">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="BACK"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:textColor="#000000" />

            <View
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/btnNext"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="NEXT"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:enabled="false"
                android:textColor="#000000" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
