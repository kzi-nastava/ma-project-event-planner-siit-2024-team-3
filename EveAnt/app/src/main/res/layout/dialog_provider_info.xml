<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/rounded_corners_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:text="Provider Information"
        android:textStyle="bold"
        android:textSize="18sp"
        android:fontFamily="@font/poppins_bold"
        android:layout_marginBottom="8dp"
        android:layout_height="50dp"
        android:layout_width="300dp"/>

    <TextView android:id="@+id/providerName" android:text="Name" android:layout_marginTop="8dp"  android:layout_height="50dp" android:layout_width="300dp"/>
    <TextView android:id="@+id/providerInfo" android:text="Info" android:layout_marginTop="4dp" android:layout_height="50dp" android:layout_width="300dp"/>

    <EditText
        android:id="@+id/reportReason"
        android:hint="Report provider..."
        android:layout_marginTop="16dp"
        android:background="@drawable/rounded_corners_gray"
        android:padding="8dp"
        android:minHeight="60dp"
        android:layout_height="60dp"
        android:layout_width="300dp"/>

    <Button
        android:id="@+id/btnSubmitReport"
        android:text="Submit Report"
        android:layout_marginTop="12dp"
        android:background="@drawable/rounded_corners_8599e0"
        android:textColor="@android:color/white"
        android:layout_height="50dp"
        android:layout_width="300dp"/>
</LinearLayout>
