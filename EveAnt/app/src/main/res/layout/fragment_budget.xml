<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp">

    <!-- Glavni container -->
    <LinearLayout
        android:id="@+id/cardRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/rounded_corners_white">

        <!-- Naslov -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Plan your budget"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins_bold"
            android:textColor="#000000"
            android:paddingBottom="6dp" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Suggested categories based on event type"
            android:textSize="14sp"
            android:fontFamily="@font/poppins_regular"
            android:textColor="#88000000"
            android:paddingBottom="12dp" />

        <!-- 🔥 Lista predloženih kategorija -->
        <LinearLayout
            android:id="@+id/suggestedCategoriesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnAddItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+"
            android:backgroundTint="@color/purple"
            android:textColor="@android:color/white"
            android:background="@drawable/rounded_corners_e8e8e8"
            android:layout_gravity="end"
            android:layout_marginBottom="8dp"
            android:textAllCaps="false"/>


        <!-- 📦 Lista stavki u budžetu -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your Budget Items"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_bold"
            android:textColor="#000000"
            android:paddingBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvItems"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

        <!-- 🧮 Total i Remaining -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp">

            <TextView
                android:id="@+id/tvTotalBudget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total: 0 RSD"
                android:textSize="16sp"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/purple" />

            <TextView
                android:id="@+id/tvRemainingBudget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Remaining: 0 RSD"
                android:textSize="16sp"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/gray" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
